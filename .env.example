app.baseURL = 'http://localhost/flowtrack-backend/public/'
app.frontendURL = 'http://localhost:5173'

database.default.hostname = localhost
database.default.database = flowtrack
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

JWT_SECRET_KEY = change-this-to-a-strong-secret

# Frontend (in frontend/.env)
# VITE_API_URL=http://localhost/flowtrack-backend/public/api/v1

# Desktop (optional)
# FLOWTRACK_API_URL=http://localhost/flowtrack-backend/public/api/v1
