app.baseURL = 'http://localhost/flowtrack-backend/public/'
app.frontendURL = 'http://localhost:5173'
# Staging/production example:
# app.frontendURL = 'https://flowtrackhani.vercel.app'
# For ngrok/staging, set app.baseURL to your public tunnel URL, e.g.:
# app.baseURL = 'https://548a-124-109-46-74.ngrok-free.app/flowtrack-backend/public/'

database.default.hostname = localhost
database.default.database = flowtrack
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

JWT_SECRET_KEY = change-this-to-a-strong-secret

#--------------------------------------------------------------------
# SOCIAL LOGIN (OAuth) — Google & GitHub
#--------------------------------------------------------------------
# Redirect URIs default to {app.baseURL}api/v1/auth/{provider}/callback when
# left blank. Register that exact URL in the provider console.
GOOGLE_CLIENT_ID =
GOOGLE_CLIENT_SECRET =
GOOGLE_REDIRECT_URI =

GITHUB_CLIENT_ID =
GITHUB_CLIENT_SECRET =
GITHUB_REDIRECT_URI =

# Slack (org integration) — api.slack.com/apps
SLACK_CLIENT_ID =
SLACK_CLIENT_SECRET =
SLACK_REDIRECT_URI =
# Slack slash commands / interactivity signing secret (Phase 12 command center)
SLACK_SIGNING_SECRET =

# Microsoft Teams outgoing-webhook HMAC secret (Phase 12; base64, optional)
TEAMS_OUTGOING_SECRET =

# Jira / Atlassian (org integration) — developer.atlassian.com (OAuth 2.0 3LO)
JIRA_CLIENT_ID =
JIRA_CLIENT_SECRET =
JIRA_REDIRECT_URI =

# Google Calendar (defaults to GOOGLE_CLIENT_ID/SECRET when left blank)
GOOGLE_CALENDAR_CLIENT_ID =
GOOGLE_CALENDAR_CLIENT_SECRET =
GOOGLE_CALENDAR_REDIRECT_URI =

# Microsoft 365 / Outlook Calendar (Microsoft Graph)
MICROSOFT_CLIENT_ID =
MICROSOFT_CLIENT_SECRET =
MICROSOFT_REDIRECT_URI =

#--------------------------------------------------------------------
# AI ENGINE (OpenAI-compatible)
#--------------------------------------------------------------------
AI_ENABLED = true
OPENAI_API_KEY =
AI_MODEL = gpt-4o-mini
# AI_BASE_URL = https://api.openai.com/v1
# AI_MAX_TOKENS = 800
# AI_TEMPERATURE = 0.3

# Stripe (subscription checkout)
# STRIPE_SECRET_KEY = sk_test_...
# STRIPE_WEBHOOK_SECRET = whsec_...
# Optional explicit price IDs (overrides DB values when set):
# STRIPE_PRICE_STARTER_MONTHLY = price_...
# STRIPE_PRICE_STARTER_YEARLY = price_...
# STRIPE_PRICE_PROFESSIONAL_MONTHLY = price_...
# STRIPE_PRICE_PROFESSIONAL_YEARLY = price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY = price_...
# STRIPE_PRICE_ENTERPRISE_YEARLY = price_...
# Auto-create missing Stripe prices in development (default: on in development)
# STRIPE_AUTO_CREATE_PRICES = true

# Central deploy URL (update config/deploy.json when moving to production)
# apiBaseUrl + publicBaseUrl drive frontend/.env.production and desktop builds

# Frontend (in frontend/.env for local dev)
# VITE_API_URL=http://localhost/flowtrack-backend/public/api/v1

# Desktop (optional override)
# FLOWTRACK_API_URL=http://localhost/flowtrack-backend/public/api/v1

#--------------------------------------------------------------------
# EMAIL (SMTP)
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = oncologypanel.com
email.SMTPUser = noreply@oncologypanel.com
email.SMTPPass = your-email-account-password
email.SMTPPort = 465
email.SMTPCrypto = ssl
email.fromEmail = noreply@oncologypanel.com
email.fromName = FlowTrack
email.mailType = html
email.SMTPTimeout = 15
