{
    "name": "flowtrack-desktop",
    "version": "1.0.0",
    "description": "FlowTrack desktop time tracker",
    "main": "main.js",
    "author": "FlowTrack",
    "license": "ISC",
    "scripts": {
        "icons": "node scripts/generate-icons.js",
        "prestart": "node scripts/generate-icons.js",
        "predev": "node scripts/generate-icons.js",
        "start": "electron . --disable-gpu-sandbox",
        "dev": "electron . --disable-gpu-sandbox",
        "sync-env": "node ../scripts/sync-deploy-env.js",
        "build:frontend": "npm run sync-env && cd ../frontend && npm run build",
        "pack:win": "node scripts/prepack-clean.js && npm run icons && npm run build:frontend && electron-builder --win && node ../scripts/publish-installers.js",
        "pack:mac": "npm run icons && npm run build:frontend && electron-builder --mac && node ../scripts/publish-installers.js",
        "pack": "npm run icons && npm run build:frontend && electron-builder --win --mac && node ../scripts/publish-installers.js",
        "dist:win": "npm run pack:win",
        "dist:mac": "npm run pack:mac",
        "dist": "npm run pack"
    },
    "dependencies": {
        "active-win": "^8.2.1",
        "axios": "^1.6.0",
        "form-data": "^4.0.0"
    },
    "devDependencies": {
        "electron": "^31.0.0",
        "electron-builder": "^25.1.8",
        "png-to-ico": "^2.1.8",
        "sharp": "^0.33.5"
    },
    "build": {
        "npmRebuild": false,
        "buildDependenciesFromSource": false,
        "appId": "com.flowtrack.desktop",
        "productName": "FlowTrack",
        "icon": "build/icon.png",
        "directories": {
            "output": "dist-build",
            "buildResources": "build"
        },
        "files": [
            "main.js",
            "activityTracker.js",
            "systemInput.js",
            "networkInfo.js",
            "timerReminderPrompt.js",
            "preload.js",
            "config.js",
            "icon.png",
            "package.json",
            "node_modules/active-win/**/*",
            "node_modules/@mapbox/**/*",
            "node_modules/node-gyp-build/**/*"
        ],
        "asarUnpack": [
            "**/node_modules/active-win/**"
        ],
        "extraResources": [
            {
                "from": "../frontend/dist",
                "to": "frontend/dist",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../config/deploy.json",
                "to": "config/deploy.json"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "FlowTrack-Setup.${ext}",
            "icon": "build/icon.ico",
            "signAndEditExecutable": false
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "category": "public.app-category.productivity",
            "artifactName": "FlowTrack.${ext}",
            "icon": "build/icon.png",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "dmg": {
            "title": "FlowTrack"
        }
    }
}
