# Disable directory browsing
Options -Indexes

# ----------------------------------------------------------------------
# CORS preflight (OPTIONS only — POST/GET headers come from CodeIgniter cors filter)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
	SetEnvIf Request_Method ^OPTIONS$ IS_OPTIONS=1
	SetEnvIf Origin "^https://([\w-]+\.)?vercel\.app$" CORS_ALLOW_ORIGIN=$0
	SetEnvIf Origin "^http://localhost:5173$" CORS_ALLOW_ORIGIN=$0
	SetEnvIf Origin "^http://127\.0\.0\.1:5173$" CORS_ALLOW_ORIGIN=$0
	SetEnvIf Origin "^http://localhost:3000$" CORS_ALLOW_ORIGIN=$0

	Header always set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=IS_OPTIONS
	Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" env=IS_OPTIONS
	Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, ngrok-skip-browser-warning" env=IS_OPTIONS
	Header always set Access-Control-Expose-Headers "Authorization" env=IS_OPTIONS
	Header always set Access-Control-Max-Age "3600" env=IS_OPTIONS
</IfModule>

# ----------------------------------------------------------------------
# Rewrite engine
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
	Options +FollowSymlinks
	RewriteEngine On
	RewriteBase /flowtrack-backend/public/

	# CORS preflight: 204 for allowed origins (paired with mod_headers above)
	RewriteCond %{REQUEST_METHOD} OPTIONS
	RewriteCond %{HTTP:Origin} ^https://([\w-]+\.)?vercel\.app$ [NC,OR]
	RewriteCond %{HTTP:Origin} ^http://localhost:5173$ [NC,OR]
	RewriteCond %{HTTP:Origin} ^http://127\.0\.0\.1:5173$ [NC,OR]
	RewriteCond %{HTTP:Origin} ^http://localhost:3000$ [NC]
	RewriteRule ^ - [R=204,L]

	# Redirect Trailing Slashes...
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_URI} (.+)/$
	RewriteRule ^ %1 [L,R=301]

	# Rewrite "www.example.com -> example.com"
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]

	# Front controller
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

	# Ensure Authorization header is passed along
	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
	ErrorDocument 404 index.php
</IfModule>

ServerSignature Off
